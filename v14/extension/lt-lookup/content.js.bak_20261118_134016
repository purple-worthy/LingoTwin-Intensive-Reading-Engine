    const style = document.createElement('style');
    style.textContent = CSS;

    chip = document.createElement('button');
    chip.className = 'lt-chip';
    chip.type = 'button';

    panel = document.createElement('aside');
    panel.className = 'lt-panel';
    panel.innerHTML = `
